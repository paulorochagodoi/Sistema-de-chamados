# =============================================================================
# Sistema ITSM containerizado — variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie para .env e ajuste. NUNCA versione o .env preenchido.
#   cp .env.example .env && ./scripts/gen-secrets.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Domínio e roteamento (Traefik)
# -----------------------------------------------------------------------------
# Em desenvolvimento use itsm.localhost (resolve para 127.0.0.1 na maioria dos SOs).
# Em produção use seu domínio real e aponte os subdomínios abaixo para o Ingress.
DOMAIN=itsm.localhost
ACME_EMAIL=admin@example.com
# Resolver ACME usado apenas pelo overlay docker-compose.tls.yml
TRAEFIK_CERT_RESOLVER=letsencrypt
# Porta HTTP/HTTPS publicadas pelo Traefik no host
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
# Dashboard do Traefik (mantenha desabilitado em produção ou proteja por SSO)
TRAEFIK_DASHBOARD=false
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Imagens (pinadas — troque por digests em produção)
# -----------------------------------------------------------------------------
TRAEFIK_IMAGE=traefik:v3.7
MARIADB_IMAGE=mariadb:11.4
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:3.13-management
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0
GLPI_IMAGE=glpi/glpi:10.0.26
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.17.1
MESHCENTRAL_IMAGE=typhonragewind/meshcentral:1.1.53
RUSTDESK_IMAGE=rustdesk/rustdesk-server:latest
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.37.6
METABASE_IMAGE=metabase/metabase:v0.51.8
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
GRAFANA_IMAGE=grafana/grafana:11.4.0
LOKI_IMAGE=grafana/loki:3.3.2
PROMTAIL_IMAGE=grafana/promtail:3.3.2
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2

# -----------------------------------------------------------------------------
# MariaDB — banco do GLPI (o GLPI suporta apenas MySQL/MariaDB; ver ADR-001)
# -----------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=troque-me-root
GLPI_DB_HOST=mariadb
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=troque-me-glpi

# -----------------------------------------------------------------------------
# PostgreSQL — Keycloak, Chatwoot, n8n, Metabase
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=troque-me-postgres
KEYCLOAK_DB_PASSWORD=troque-me-keycloak-db
CHATWOOT_DB_PASSWORD=troque-me-chatwoot-db
N8N_DB_PASSWORD=troque-me-n8n-db
METABASE_DB_PASSWORD=troque-me-metabase-db

# -----------------------------------------------------------------------------
# Redis / RabbitMQ
# -----------------------------------------------------------------------------
REDIS_PASSWORD=troque-me-redis
RABBITMQ_USER=itsm
RABBITMQ_PASSWORD=troque-me-rabbit

# -----------------------------------------------------------------------------
# MinIO (anexos e backups, compatível com S3)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=itsm-admin
MINIO_ROOT_PASSWORD=troque-me-minio-32-chars-minimo

# -----------------------------------------------------------------------------
# Keycloak (SSO)
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-me-keycloak-admin
KEYCLOAK_REALM=itsm

# -----------------------------------------------------------------------------
# GLPI
# -----------------------------------------------------------------------------
# Tokens gerados na UI do GLPI: Configurar > Geral > API
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# -----------------------------------------------------------------------------
# itsm-bridge (serviço de integração próprio)
# -----------------------------------------------------------------------------
BRIDGE_LOG_LEVEL=INFO
# Segredos HMAC dos webhooks (sha256). Vazio = validação desabilitada (apenas dev).
BRIDGE_RMM_WEBHOOK_SECRET=
BRIDGE_CHATWOOT_WEBHOOK_SECRET=
# Entidade GLPI padrão quando o alerta não identifica o cliente (0 = raiz)
BRIDGE_DEFAULT_ENTITY_ID=0
# Janela de deduplicação de alertas repetidos, em segundos
BRIDGE_DEDUPE_TTL_SECONDS=900
# Por quanto tempo uma conversa do Chatwoot continua alimentando o mesmo chamado
BRIDGE_CONVERSATION_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# Chatwoot (omnichannel)
# -----------------------------------------------------------------------------
# Gere com: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=troque-me-chatwoot-secret-key-base
CHATWOOT_DEFAULT_LOCALE=pt_BR

# -----------------------------------------------------------------------------
# MeshCentral (RMM / acesso não supervisionado)
# -----------------------------------------------------------------------------
MESHCENTRAL_ALLOW_NEW_ACCOUNTS=false
MESHCENTRAL_BACKUPS_PW=troque-me-mesh-backup

# -----------------------------------------------------------------------------
# RustDesk (acesso remoto sob demanda)
# -----------------------------------------------------------------------------
# IP/hostname público do servidor de relay, visto pelos clientes
RUSTDESK_RELAY_HOST=rustdesk.example.com

# -----------------------------------------------------------------------------
# n8n (automação)
# -----------------------------------------------------------------------------
# Gere com: openssl rand -hex 32 — perder esta chave invalida as credenciais salvas
N8N_ENCRYPTION_KEY=troque-me-n8n-encryption-key

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-me-grafana
